/pr40_runs.json
/pr40_status.json
/push*.txt
/runs*.txt
/runstatus.txt
/submit_pr.cmd
/.codebuddy/plans/
# CodeBuddy local data (keep on local machine, do not upload to GitHub)
.codebuddy/

# Misc
*.swp
*.swo
*~

# Python bytecode cache (scripts/*.py are executed by CI and locally)
__pycache__/
*.py[cod]

# T83: bundled Ubuntu rootfs staged at build time (87MB total, never committed;
# fetched + verified by scripts/fetch_rootfs.sh against rootfs-bundle.sha256)
platform/terminal/src/main/jniLibs/*/libubuntu-rootfs.so

# Changelog channel v1: changelog.json is generated by release.yml at build
# time (scripts/changelog.py build) and embedded as the offline fallback
# asset — the generated copy is never committed (source tree stays clean)
app/src/main/assets/changelog.json
