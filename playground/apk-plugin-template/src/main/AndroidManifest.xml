<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 模板 manifest：对齐 plugins/plugin-workflow 参考实现。
         不引用 @mipmap 图标：插件 APK 无 res 资源（悬空引用无法通过 AAPT 链接），
         缺省走系统应用图标即可安装。 -->
    <application
        android:label="Apex Game Plugin">

        <!-- 游戏壳 Activity：全屏 WebView 运行 assets/game.html。
             exported 不设（插件内页无需外部唤起；宿主侧经工具回执以
             startActivity 方式拉起时同应用内启动不受限）。 -->
        <activity
            android:name=".GameActivity"
            android:theme="@android:style/Theme.Material.NoActionBar"
            android:configChanges="orientation|screenSize|keyboardHidden" />

        <!-- 插件服务：宿主经此 Service 绑定插件（exported：宿主是独立 APK，
             必须跨进程绑定）。信任模型同 plugin-workflow：安全由宿主侧
             签名门（PluginManager 绑定回调比对签名）承担。 -->
        <service
            android:name=".GamePluginService"
            android:exported="true">
            <intent-filter>
                <action android:name="com.apex.agent.plugin.PLUGIN" />
            </intent-filter>
        </service>

    </application>
</manifest>
