<?xml version="1.0" encoding="utf-8"?>
<!-- 逆向 MCP Host（issue #173）：手机作为 MCP Server 供 PC 端 AI 接入。中文文案。 -->
<resources>
    <!-- ═══ 卡片头 / 状态 ═══ -->
    <string name="mcphost_title">MCP Host（外部 AI 接入）</string>
    <string name="mcphost_subtitle">让 PC 端 AI（Cline / Claude Desktop）通过 streamable HTTP 控制这台手机</string>
    <string name="mcphost_status_running">运行中 · %1$d 个会话</string>
    <string name="mcphost_status_stopped">已停止</string>
    <string name="mcphost_error_prefix">错误：%1$s</string>

    <!-- ═══ 端口 / 限速 ═══ -->
    <string name="mcphost_port_label">端口</string>
    <string name="mcphost_rate_label">限速（请求/分钟）</string>
    <string name="mcphost_field_range">请输入 %1$d–%2$d</string>

    <!-- ═══ S-04：绑定面与暴露面开关 ═══ -->
    <string name="mcphost_lan_label">允许局域网访问（监听全部网卡）</string>
    <string name="mcphost_lan_warning">⚠️ 流量为明文 HTTP —— 同网络者皆可截获。默认仅监听本机回环（127.0.0.1）；PC 连接需开启本开关并确保网络可信（更安全的做法是走 SSH 隧道）。</string>
    <string name="mcphost_write_label">暴露写/执行类工具</string>
    <string name="mcphost_write_hint">默认关闭：写文件、git 提交等副作用工具不暴露给外部 AI，只读工具不受影响；删除/卸载/强停等高危工具永不暴露。</string>
    <string name="mcphost_enable_confirm_title">启用 MCP Host？</string>
    <string name="mcphost_enable_confirm_text">将在本机启动 HTTP 服务器（端口 %1$d）。每个请求都必须携带 Bearer 令牌；默认仅监听回环地址、仅暴露只读工具（写类工具有独立开关，高危工具永不暴露）。</string>
    <string name="mcphost_enable_confirm_ok">启用</string>
    <string name="mcphost_enable_confirm_cancel">暂不启用</string>
    <!-- ═══ Token 行 ═══ -->
    <string name="mcphost_token_label">访问令牌（Bearer）</string>
    <string name="mcphost_token_show">显示令牌</string>
    <string name="mcphost_token_hide">隐藏令牌</string>
    <string name="mcphost_token_copy">复制令牌</string>
    <string name="mcphost_token_copied">令牌已复制</string>
    <string name="mcphost_token_regenerate">重新生成</string>
    <string name="mcphost_token_regen_title">重新生成令牌？</string>
    <string name="mcphost_token_regen_text">已连接的客户端下一次请求将被拒绝，需在每个客户端配置中更新令牌。</string>
    <string name="mcphost_regen_cancel">取消</string>

    <!-- ═══ 分类白名单 ═══ -->
    <string name="mcphost_categories_title">工具分类白名单</string>
    <string name="mcphost_categories_hint">仅白名单分类内的工具会暴露给外部 AI。默认只读友好集，高风险分类默认关闭。</string>
    <string name="mcphost_categories_risky">已启用危险分类（SHELL / TERMINAL / APP / UI / GITHUB / SECURITY）：外部 Agent 将可直接操控手机，请谨慎开启。</string>

    <!-- ═══ 硬黑名单 ═══ -->
    <string name="mcphost_blacklist_title">强制禁用工具（只读）</string>
    <string name="mcphost_blacklist_hint">vault_* 工具一律本地强制拦截（金库数据绝不出手机）。配置黑名单：%1$s</string>

    <!-- ═══ 审计日志 ═══ -->
    <string name="mcphost_audit_title">最近请求</string>
    <string name="mcphost_audit_empty">暂无请求</string>
    <string name="mcphost_audit_duration">%1$d 毫秒</string>

    <!-- ═══ 如何连接 ═══ -->
    <string name="mcphost_connect_title">如何连接（PC 端）</string>
    <string name="mcphost_connect_hint">在 Cline / Claude Desktop（mcp-remote）中按下述 JSON 添加本服务器。手机与 PC 需在同一局域网，且需开启「允许局域网访问」（默认仅监听本机回环）；使用期间请保持本应用存活。</string>
    <string name="mcphost_connect_ip_placeholder">手机IP</string>
    <string name="mcphost_connect_json">{
  \"mcpServers\": {
    \"android-guru\": {
      \"url\": \"http://%1$s:%2$d/mcp\",
      \"headers\": {
        \"Authorization\": \"Bearer %3$s\"
      }
    }
  }
}</string>
</resources>
