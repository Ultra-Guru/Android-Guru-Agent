<!-- 备份 / 恢复区中文文案（与 values/strings_backup.xml 英文默认一一对应，Task 5-c）。 -->
<resources>
    <!-- ═══ 区块说明卡（含什么 / 永不包含什么）═══ -->
    <string name="backup_section_title">备份与恢复</string>
    <string name="backup_section_desc">把设置与聊天历史导出为一个 JSON 文件，在新设备上恢复。文件保存到你选择的位置。</string>
    <string name="backup_security_included">包含：模型 Profile、Provider、角色映射、Agent 设置与聊天历史。</string>
    <string name="backup_security_never">永不以明文包含：API 密钥与金库密钥。Provider 的 API 密钥在导出时被剥离，恢复后需重新录入。</string>
    <string name="backup_vault_envelope_note">金库只能以口令加密的 AES-GCM 信封形式导出。</string>

    <!-- ═══ 导出区 ═══ -->
    <string name="backup_export_title">导出</string>
    <string name="backup_include_vault">包含金库（加密）</string>
    <string name="backup_include_vault_desc">用口令加密整个金库，导入时需要再次输入同一口令</string>
    <string name="backup_passphrase_label">口令</string>
