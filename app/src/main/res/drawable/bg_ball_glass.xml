<?xml version="1.0" encoding="utf-8"?>
<!-- v1.4.1 透明玻璃球底座：极轻透明材质（用户要求「悬浮球做成透明的」；
     去霓虹重调：旧青色霓虹描边+青色外晕 → 中性玻璃描边+柔和阴影）。
     旧 bg_obsidian_glossy（高光黑曜石，重不透明）退役：仅 30% 透明度的玻璃
     底 + 极细中性描边 + 柔和暗晕，视觉重量最小化，状态环 NeonRingView 仍是
     主要氛围来源。 -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- 底层：极柔暗晕（透出下层界面，替代旧青色辉光） -->
    <item>
        <shape android:shape="oval">
            <solid android:color="#12000000" />
        </shape>
    </item>

    <!-- 主层：透明玻璃核（40% 暗 + 细中性描边） -->
    <item android:top="5dp" android:bottom="5dp" android:left="5dp" android:right="5dp">
        <shape android:shape="oval">
            <solid android:color="#660B0F14" />
            <stroke
                android:width="1dp"
                android:color="#59DDE7ED" />
        </shape>
    </item>

    <!-- 顶弧：极轻镜面反射（10% 高光，玻璃质感的最小暗示） -->
    <item android:top="7dp" android:left="12dp" android:right="12dp" android:height="10dp">
        <shape android:shape="oval">
            <gradient
                android:angle="270"
                android:startColor="#26FFFFFF"
                android:endColor="#00FFFFFF"
                android:type="linear" />
        </shape>
    </item>
</layer-list>
