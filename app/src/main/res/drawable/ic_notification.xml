<?xml version="1.0" encoding="utf-8"?>
<!--
  Status-bar notification icon — Viro invader silhouette (alpha-only, white).

  Notification icons are alpha masks: the system tints them, so only the
  glyph geometry matters. 7×7 grid at viewport 7 fills the 24dp canvas the
  way status icons expect (no inner padding).
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="7"
    android:viewportHeight="7">
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M0,0 h7 v1 h-7 z
            M1,1 h1 v1 h-1 z M3,1 h1 v1 h-1 z M5,1 h1 v1 h-1 z
            M0,2 h7 v1 h-7 z
            M0,3 h7 v1 h-7 z
            M2,4 h1 v1 h-1 z M4,4 h1 v1 h-1 z
            M1,5 h5 v1 h-5 z
            M0,6 h1 v1 h-1 z M2,6 h1 v1 h-1 z M4,6 h1 v1 h-1 z M6,6 h1 v1 h-1 z" />
</vector>
