<?xml version="1.0" encoding="utf-8"?>
<!--
  P1 fix（数据一致性/安全）：Android 12+ 云备份与设备迁移规则。
  github_secure_prefs 的 Tink keyset 依赖 AndroidKeyStore 硬件绑定 MasterKey，
  密文文件随备份迁移到新机后 MasterKey 不迁移 → EncryptedSharedPreferences.create
  抛 AEADBadTagException → catch 分支静默降级为明文 SharedPreferences（永久明文落盘）。
  排除两份 prefs 使云恢复不再触发该降级路径，用户在新机重新登录即可。

  v1.4.4 #5（安全缺口修复）：vault_secure_prefs（凭据金库）与 apex_secure_settings
  （Provider API key）同为 EncryptedSharedPreferences，存在完全相同的密文迁移降级
  问题 —— 一并排除；vault 数据改走应用内加密备份（backup/BackupManager，
  口令派生密钥的信封格式，跨设备可解）；API key 在新机重新录入。
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="github_secure_prefs.xml" />
        <exclude domain="sharedpref" path="github_prefs_fallback.xml" />
        <exclude domain="sharedpref" path="vault_secure_prefs.xml" />
        <exclude domain="sharedpref" path="vault_prefs_fallback.xml" />
        <exclude domain="sharedpref" path="apex_secure_settings.xml" />
        <exclude domain="sharedpref" path="apex_secure_settings_fallback.xml" />
        <!-- S-05：逆向 MCP Host 的 Bearer token（McpHostManager，明文 prefs）；
             PulseMCP 凭据（PulseMcpCredentialsStore，EncryptedSharedPreferences
             + keystore 失配时的明文 fallback）—— 与上方六项同源缺口：
             密文迁移到新机必触发明文降级，明文 token 更不该出设备。 -->
        <exclude domain="sharedpref" path="mcp_host_prefs.xml" />
        <exclude domain="sharedpref" path="pulse_mcp_secure_prefs.xml" />
        <exclude domain="sharedpref" path="pulse_mcp_secure_prefs-fallback.xml" />
        <!-- Git 审计 P2-10（#836）：file domain 一并排除——logs/ 含
             tool-audit.jsonl（工具审计的完整命令串）、crash/ 含崩溃现场
             （可能带敏感参数）、mcp_config/ 含 MCP 服务器配置（headers 可
             含令牌字段）、rootfs/ 是 Ubuntu 沙箱本体（体积巨大且
             rootfs/tmp 可能残留 askpass 凭据脚本）——全部不应出设备。
             记忆 P0（#836 补全）：memory_kit/ 是认知记忆库本体（情景/
             宏/图谱/聊天事实，含用户自述与任务轨迹）、anr/ 是主线程
             看门狗的堆栈转储 —— 同源敏感能据，不随云备份/换机迁移出设备。 -->
        <exclude domain="file" path="logs/" />
        <exclude domain="file" path="crash/" />
        <exclude domain="file" path="anr/" />
        <exclude domain="file" path="mcp_config/" />
        <exclude domain="file" path="memory_kit/" />
        <exclude domain="file" path="rootfs/" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="github_secure_prefs.xml" />
        <exclude domain="sharedpref" path="github_prefs_fallback.xml" />
        <exclude domain="sharedpref" path="vault_secure_prefs.xml" />
        <exclude domain="sharedpref" path="vault_prefs_fallback.xml" />
        <exclude domain="sharedpref" path="apex_secure_settings.xml" />
        <exclude domain="sharedpref" path="apex_secure_settings_fallback.xml" />
        <!-- S-05：同 cloud-backup —— 凭据类 prefs 不随设备迁移出设备。
             Git 审计 P2-10 + 记忆 P0（#836 补全）：file domain 同源排除
             （审计日志/崩溃现场/ANR 转储/MCP 配置/记忆库本体/沙箱本体）。 -->
        <exclude domain="sharedpref" path="mcp_host_prefs.xml" />
        <exclude domain="sharedpref" path="pulse_mcp_secure_prefs.xml" />
        <exclude domain="sharedpref" path="pulse_mcp_secure_prefs-fallback.xml" />
        <exclude domain="file" path="logs/" />
        <exclude domain="file" path="crash/" />
        <exclude domain="file" path="anr/" />
        <exclude domain="file" path="mcp_config/" />
        <exclude domain="file" path="memory_kit/" />
        <exclude domain="file" path="rootfs/" />
    </device-transfer>
</data-extraction-rules>
