<resources>
    <!-- ═══ v4 Coding 模式级联选择器（Build 二级自主级别 / Plan / Goal）═══ -->

    <!-- 触发胶囊无障碍描述（%1$s = 组合标签，如 "Build · Semi-autonomous (clarify: on)"） -->
    <string name="code_cascade_chip_cd">Task mode: %1$s. Tap to switch</string>

    <!-- Build 一级项（点击只展开/收起二级，不切换模式） -->
    <string name="code_cascade_build_expand_cd">Build: expand autonomy submenu</string>
    <string name="code_cascade_build_collapse_cd">Build: collapse autonomy submenu</string>

    <!-- Plan / Goal 一级项（点击直接选中） -->
    <string name="code_cascade_mode_select_cd">%1$s: select this mode</string>

    <!-- ═══ 三档自主级别（提问策略）═══ -->

    <string name="autonomy_level_label">Autonomy level</string>
    <string name="autonomy_name_interactive">Interactive</string>
    <string name="autonomy_name_semi">Semi-autonomous</string>
    <string name="autonomy_name_fully">Fully autonomous</string>

    <string name="autonomy_desc_interactive">Asks whenever a correctness-affecting ambiguity exists; merges same-topic questions</string>
    <string name="autonomy_desc_semi">Asks only what materially affects acceptance; decides the rest and records assumptions</string>
    <string name="autonomy_desc_fully">Zero questions while executing; decides and records assumptions and risks</string>

    <!-- 自主级别行无障碍描述（%1$s = 级别名；%2$s = 选中态后缀或空） -->
    <string name="autonomy_option_cd">Autonomy level: %1$s%2$s</string>
    <string name="autonomy_selected_suffix">, selected</string>

    <!-- 完全自主的「开始前集中澄清」开关（仅完全自主选中时显示；状态跨级别保留） -->
    <string name="autonomy_pre_clarify_label">Batch clarification up front</string>
    <string name="autonomy_pre_clarify_desc">Asks all questions once before starting; skipped ones run on default assumptions</string>
    <string name="autonomy_pre_clarify_on_suffix"> (clarify: on)</string>
    <string name="autonomy_pre_clarify_cd">Batch clarification up front switch</string>

    <!-- ═══ v4 Goal 目标驱动状态机（GoalSpec 扩展字段 + 阶段展示）═══ -->

