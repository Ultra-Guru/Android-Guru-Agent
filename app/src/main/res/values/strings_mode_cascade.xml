    <string name="goal_advanced_section">Advanced fields (all optional)</string>
    <string name="goal_field_constraints">Constraints</string>
    <string name="goal_field_non_goals">Non-goals</string>
    <string name="goal_field_metrics">Success metrics</string>
    <string name="goal_field_risks">Known risks</string>

