    <string name="goal_phase_spec_ready">Spec ready</string>
    <string name="goal_phase_executing">Executing</string>
    <string name="goal_phase_verifying">Verifying</string>
    <string name="goal_phase_done">Done</string>
    <string name="goal_phase_blocked">Blocked</string>

